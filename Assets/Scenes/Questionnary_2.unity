  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Vous avez particip\xE9 \xE0 jeu de rythme \xE0 travers 5 types de t\xE2che
    diff\xE9rentes: \n\n1. Silence : Aucun retour auditif.\n2. Rythme Simple : Un
    rythme compos\xE9 d'une seule note.\n3. M\xE9lodie : Une s\xE9quence de notes
    formant une m\xE9lodie.\n4. Parole : Des mots ou phrases avec une intonation
    monotone sans accompagnement musical.\n5. Chanson : Des paroles chant\xE9es.
    \n\nPour chacune des affirmations suivantes, veuillez indiquer dans quelle mesure
    elle est vraie pour vous, en utilisant l'\xE9chelle suivante :\n\t\t\t 1\t\t2\t
    \t3\t \t4 \t\t5\t\t 6\t\t 7 \t\t\t\t\t\t\t    (pas vrai) \t\t\t\t\t  (plut\xF4t
    vrai)  \t\t\t\t      \t    (tr\xE8s vrai)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
